# Postgres direct (pgmq); local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Endpoint-ul S3 al Supabase Storage (local: http://127.0.0.1:54321/storage/v1/s3)
S3_ENDPOINT=
S3_REGION=local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# SMTP: Resend eu-west-1 în producție; Mailpit local (127.0.0.1:54325)
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Memories <no-reply@example.ro>"
APP_URL=http://localhost:3000
SENTRY_DSN=
