{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "test": "vitest run --project worker",
    "docker:build": "docker build -f Dockerfile -t memories-worker ../..",
    "docker:run": "docker run --rm --env-file .env.docker --add-host=host.docker.internal:host-gateway memories-worker",
    "docker:smoke": "docker run --rm memories-worker node scripts/smoke-heic.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@aws-sdk/lib-storage": "3.1155.0",
    "@memories/shared": "workspace:*",
    "@sentry/node": "11.8.0",
    "@supabase/supabase-js": "2.118.0",
    "exiftool-vendored": "38.1.2",
    "file-type": "22.2.0",
    "nodemailer": "10.2.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/yazl": "3.3.1"
  }
}
