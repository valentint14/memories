# Supabase (local: valorile din `pnpm supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Doar pe server; nu se prefixează niciodată cu NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
# Secret pentru HMAC-ul adresei IP (rate limiting fără stocarea IP-ului în clar)
IP_HASH_SECRET=
# Cloudflare Turnstile (002, research R3). Local/CI: cheile de test Cloudflare
# (1x00000000000000000000BB / 1x0000000000000000000000000000000AA), scrise de scripts/ci-env.mjs.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Doar local/CI și doar cu un secret de test: fără scriptul extern, verificare emulată local
TURNSTILE_OFFLINE=
# Limita de emailuri de autentificare per IP pe oră (implicit 20)
RATE_LIMIT_IP_PER_HOUR=
# Sentry, organizație în regiunea UE; gol = dezactivat
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
