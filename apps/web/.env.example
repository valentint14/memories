# Supabase (local: valorile din `pnpm supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Doar pe server; nu se prefixează niciodată cu NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
# Secret pentru HMAC-ul adresei IP (rate limiting fără stocarea IP-ului în clar)
IP_HASH_SECRET=
# Cloudflare Turnstile (002, research R3). Local/CI: cheile de test Cloudflare
# (1x00000000000000000000BB / 1x0000000000000000000000000000000AA), scrise de scripts/ci-env.mjs.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Doar local/CI și doar cu un secret de test: fără scriptul extern, verificare emulată local
TURNSTILE_OFFLINE=
# Stripe (003). Local: cheia de test (sk_test_…) din Dashboard › Developers › API keys și secretul
# afișat de `stripe listen --forward-to localhost:3000/api/stripe/webhook` (quickstart 003).
# O cheie sk_live_ e refuzată în afara producției.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Doar teste: adresa stripe-mock (CI); gol = API-ul Stripe real
STRIPE_API_BASE=
# Limita de emailuri de autentificare per IP pe oră (implicit 20)
RATE_LIMIT_IP_PER_HOUR=
# Încercările de coduri de reducere per IP pe oră (implicit 30; 005)
RATE_LIMIT_DISCOUNT_IP_PER_HOUR=
# Sentry, organizație în regiunea UE; gol = dezactivat
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
