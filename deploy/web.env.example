# Copiază în `deploy/web.env` pe server (nu se comite). Doar secretele de rulare: valorile
# NEXT_PUBLIC_* sunt deja în imagine (variabilele GitHub ale repository-ului, la build).
SUPABASE_SERVICE_ROLE_KEY=
# Adresa publică a aplicației (hostname-ul tunelului), fără / la final
APP_URL=https://memories.example.ro
# Secret aleator pentru HMAC-ul adresei IP: `openssl rand -hex 32`
IP_HASH_SECRET=
# Cheia secretă Turnstile a site-ului (Cloudflare › Turnstile)
TURNSTILE_SECRET_KEY=
# Opțional: Sentry în regiunea UE
SENTRY_DSN=
