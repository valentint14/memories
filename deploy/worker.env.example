# Copiază în `deploy/worker.env` pe server (nu se comite). Aceleași chei ca apps/worker/.env.example.
# Supabase › Connect › „Session pooler” (IPv4); conexiunea directă e doar IPv6 pe planul Free.
DATABASE_URL=
SUPABASE_URL=https://<proiect>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Supabase › Storage › S3 Connection
S3_ENDPOINT=https://<proiect>.storage.supabase.co/storage/v1/s3
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Brevo › SMTP & API (planul gratuit: 300 emailuri pe zi); expeditorul trebuie validat în Brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Memories <no-reply@memories.example.ro>"
APP_URL=https://memories.example.ro
# Destinatarii cererilor de activare, separați prin virgulă; gol = adresele din platform_admins
ADMIN_NOTIFY_EMAILS=
# 2 pe un server cu 4 GB RAM sau pe Raspberry Pi 4 GB; 3 de la 8 GB în sus
WORKER_CONCURRENCY=2
SENTRY_DSN=
